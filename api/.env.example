DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3026,http://127.0.0.1:3026
# Em produção: DJANGO_ENV=production, DJANGO_DEBUG=false, segredo aleatório
# com pelo menos 50 caracteres e hosts explícitos. O processo tem precedência.
# DJANGO_SECRET_KEY=
# API ligada apenas ao loopback pode usar DJANGO_SECURE_SSL_REDIRECT=false.
# DJANGO_SECURE_SSL_REDIRECT=true
# DATABASE_URL=postgresql://user:password@localhost:5432/logos
